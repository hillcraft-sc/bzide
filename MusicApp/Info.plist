<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.erichebert.musicapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bzide</string>
			</array>
		</dict>
	</array>
	<!-- Siri mishears "Bzide" (said "Bee-zide" or "Bee-side"), e.g. as
	     "Bzside", and then treats it as music to search for (Gitea #34). These
	     names and "sounds like" hints help it hear the app. At most three. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Bee-zide</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>bee zide</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Bee-side</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>bee side</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Bzside</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>bee zide</string>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- The phone window and CarPlay are separate scenes that can run at once. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Internet radio: many stations stream over plain http. This lets
	     AVFoundation load http audio only; API calls, artwork and playlist
	     files still need https. See CLAUDE.md (Security). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
	<!-- Weather (Live): the weather where the user is, if they turn it on. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Weather (Live) shows the weather where you are. Your approximate location, rounded to about a kilometer, is sent to Apple Weather or MET Norway.</string>
	<!-- Export compliance, so uploads don't ask each time: Bzide only uses
	     the encryption built into iOS (HTTPS, CryptoKit hashing), which is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- MET Norway's terms ask every app to give a contact in its User-Agent. -->
	<key>METNorwayContact</key>
	<string>https://git.hillcraft-sc.com</string>
	<!-- MusicBrainz's terms likewise ask for a contact in the User-Agent. -->
	<key>MusicBrainzContact</key>
	<string>https://git.hillcraft-sc.com</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
