<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator builds only. A free account's provisioning profile can't
	     carry this entitlement, so device builds leave it out until Apple
	     grants it (planned after M6). -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
