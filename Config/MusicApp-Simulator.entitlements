<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator builds only: MusicApp.entitlements plus CarPlay. Device
	     builds leave CarPlay out until Apple grants the entitlement (it
	     can't be in a provisioning profile until then). -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- Weather (Live) asks Apple Weather first; see AppleWeather.swift. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.erichebert.musicapp</string>
	</array>
</dict>
</plist>
